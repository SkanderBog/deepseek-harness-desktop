{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/env.d.ts",
    ".expo/types/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    ".temp",
    "android",
    "ios",
    "dist"
  ]
}
